{
  "name": "solvamos-studio",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "smoke": "tsx server/smoke-check.ts",
    "pay:install": "powershell -ExecutionPolicy Bypass -File scripts/install-pay.ps1",
    "pay:gateway": "pay --sandbox server start pay/solvamos-provider.yml --bind 127.0.0.1:1402",
    "pay:gateway:localnet": "pay --sandbox server start pay/solvamos-provider.yml --bind 127.0.0.1:1402",
    "pay:gateway:devnet": "pay server start pay/solvamos-provider.devnet.yml --bind 127.0.0.1:1402",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.0",
    "@google-cloud/aiplatform": "^6.9.0",
    "@google-cloud/kms": "^5.2.0",
    "@google-cloud/resource-manager": "^6.2.0",
    "@google-cloud/secret-manager": "^6.2.0",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.1.0",
    "googleapis": "^150.0.1",
    "jose": "^6.2.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prisma": "^6.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
