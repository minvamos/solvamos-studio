# 생성은 Vertex AI ADC 우선. GEMINI_API_KEY는 developer API fallback용.
GEMINI_API_KEY=

# Hosting (Cloud Run sets PORT=8080)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Auth — production requires >=32 chars (Secret Manager: jwt-secret)
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Platform DB — GCP Cloud SQL (PostgreSQL). Required for local npm run dev too.
# Local: run Cloud SQL Auth Proxy → 127.0.0.1:5432
# DATABASE_URL=postgresql://solvamos:PASSWORD@127.0.0.1:5432/solvamos_studio?schema=public
# Cloud Run: postgresql://USER:PASS@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
# Secret Manager name: database-url
DATABASE_URL=

# GCP — shared PoC (dev). Product: TENANCY_MODE=isolated + Org.
GOOGLE_CLOUD_PROJECT=
# Optional: path to SA JSON (else gcloud ADC / Cloud Run runtime SA)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sa.json
SOLVAMOS_TENANT_ID=demo
CUSTOMER_TIER=starter
KMS_KEY_NAME=
# Leave empty in product — each agent gets its own data store id (saved on agent record).
# Lab PoC only: set both to force one shared store for all agents.
# VERTEX_SHARED_DATA_STORE=true
# VERTEX_DATA_STORE_ID=
VERTEX_DATA_STORE_ID=
VERTEX_SHARED_DATA_STORE=false
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_COLLECTION=default_collection
# Create/update hard-fail: any pipeline step failure aborts (no soft-fail).
# Dev logs / evidence buffers (in-memory + .data JSON)
# DEV_LOG_BUFFER_SIZE=2500
# INVOKE_EVIDENCE_BUFFER_SIZE=500
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth SSO (Web Client) — see docs/DRIVE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ALLOW_ADC_DRIVE=false

# Tenancy: shared = Cloud Run per tenant in one project (Lab) | isolated = cust-* under Org (product)
TENANCY_MODE=shared
# mock | shared | terraform-only | live
PROVISION_MODE=shared
# Keep false until Org + billing exist (logic present, inactive)
ENABLE_ORG_PROJECT_CREATE=false
SOLVAMOS_ORG_ID=
SOLVAMOS_CUSTOMERS_FOLDER_ID=
SOLVAMOS_BILLING_ACCOUNT=
# Lab: deploy sv-{tenant} into GOOGLE_CLOUD_PROJECT on tenant create
DEPLOY_TENANT_CLOUD_RUN=true
CLOUD_RUN_REGION=asia-northeast3
CLOUD_RUN_MIN_INSTANCES=1
# After first image build (solvamos-cloudrun/scripts/deploy.ps1):
# SHARED_CLOUD_RUN_IMAGE=asia-northeast3-docker.pkg.dev/PROJECT/REPO/studio:latest
SHARED_CLOUD_RUN_IMAGE=

# Security toggles — LOCAL ONLY. Production MUST set both false (see docs/DEPLOY_ENV.md)
ALLOW_LOCAL_VAULT_FALLBACK=true
ALLOW_PAYMENT_BYPASS=true

# --- Payment / pay.sh (Devnet only — no mainnet; localnet/sandbox retired) ---
# Devnet = pay.sh without --sandbox, Solana Devnet on-chain USDC (faucet tokens)
PAYMENT_NETWORK=devnet
# Official local gateway (Lab only). Production MUST be the public Cloud Run pay-gateway URL, e.g.
# https://solvamos-pay-gateway-<PROJECT_NUMBER>.asia-northeast3.run.app
# CI deploy sets this automatically after building Dockerfile.pay-gateway.
# Leaving localhost in production makes paid A2A fail (then Studio falls back to self best-effort).
PAY_GATEWAY_URL=http://127.0.0.1:1402
PAY_ORIGIN_URL=http://127.0.0.1:3000
# 현재 provider YAML은 고정 가격. Agent별 가변 fee와 동기화하는 동적 gateway pricing은 미구현.
PAY_GATEWAY_PRICE_USDC=0.001
# Must match gateway env when starting pay server (routing.auth header)
PAY_INTERNAL_SECRET=dev-pay-internal
# Local Lab: Studio owns/restarts one pay process when UI mode changes.
# Forced off in NODE_ENV=production / Cloud Run.
PAY_GATEWAY_MANAGED=true
# First Surfpool wallet funding can take time.
PAY_GATEWAY_READY_TIMEOUT_MS=120000
# Catalog + A2A paid peers use gateway URLs
USE_PAY_GATEWAY=true
# Legacy MOCK_/PAYSH_LOCAL_/PAYSH_A2A_ proofs — keep false for real pay.sh
ALLOW_LEGACY_SANDBOX_PROOF=false
# Optional: path to pay.exe if not on PATH / tools/pay
# PAY_CLI_PATH=F:\SOLANA\solvamos-studio\tools\pay\pay.exe

# Agent A2A vault default (when creating agents without explicit user wallet override)
# DEFAULT_AGENT_VAULT_PUBKEY=6xP7XpU6ZqUvS9uN8tV7nN8dM9pU8vS7nN9tU8vS7nN9
PLATFORM_TREASURY_PUBKEY=AoUNKE8uQ8y1FEtU6YSFCsopK9veP6jZ6EGNoULjdwva
PLATFORM_FEE_SHARE=0.1
DEFAULT_AGENT_FEE_USDC=0.001

# SolVamos platform catalog (discovery). Official pay.sh registry is NOT used.
# Paid calls still settle via pay.sh-compatible gateway (x402/MPP): USE_PAY_GATEWAY + PAY_GATEWAY_URL
# PAYSH_CATALOG_URL / PAYSH_CATALOG_MODE are ignored.
# Optional public catalog site (source of truth for discovery — separate solvamos-catalog repo)
# CATALOG_SITE_URL=https://solvamos-catalog-2ggrwml2ba-du.a.run.app
# Must match catalog service CATALOG_ADMIN_SECRET
# CATALOG_ADMIN_SECRET=
# CATALOG_CORS_ORIGINS=*
