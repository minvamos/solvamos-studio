// SolVamos Studio — platform database (Control Plane)
// Agents live in Agent (runtime). Public discovery lives in CatalogAgent.
// Users own agents via AgentOwnership (agentId = CatalogAgent.agentId = Agent.id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform identity (email/password and/or Google)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  picture         String?
  /// scrypt/bcrypt hash — null if Google-only until password set
  passwordHash    String?
  /// Google subject (openid sub) when linked
  googleSub       String?   @unique
  emailVerifiedAt DateTime?
  /// Primary workspace tenant (shared lab GCP treated as customer)
  primaryTenantId String?
  primaryTenant   Tenant?   @relation("UserPrimaryTenant", fields: [primaryTenantId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions   Session[]
  wallets    Wallet[]
  members    TenantMember[]
  ownerships AgentOwnership[]
  catalogAgents CatalogAgent[] @relation("CatalogAgentOwner")

  @@index([primaryTenantId])
}

/// Auth session — cookie sid → row; refresh JWT hashed here for rotation
model Session {
  id               String    @id
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String?
  name             String?
  picture          String?
  /// Google Drive OAuth tokens (server-only)
  accessToken      String?   @db.Text
  refreshToken     String?   @db.Text
  expiry           DateTime?
  /// password | oauth | adc | link
  via              String    @default("password")
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// SHA-256 of current refresh JWT (rotation + reuse detection)
  refreshTokenHash String?
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([tenantId])
  @@index([userId])
  @@index([refreshTokenHash])
}

/// Customer workspace — Lab: maps to shared GOOGLE_CLOUD_PROJECT
model Tenant {
  id                  String   @id
  displayName         String
  projectId           String
  folderId            String?
  tier                String   @default("starter")
  status              String   @default("active")
  kmsKeyId            String?
  cloudRunUri         String?
  cloudRunServiceName String?
  cloudRunStatus      String?
  errorMessage        String?  @db.Text
  byoProject          Boolean  @default(false)
  tenancyMode         String?
  sharedProject       Boolean  @default(true)
  provisionNotes      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members      TenantMember[]
  agents       Agent[]
  sessions     Session[]
  catalogAgents CatalogAgent[]
  primaryUsers User[]          @relation("UserPrimaryTenant")
}

model TenantMember {
  tenantId  String
  userId    String
  role      String   @default("owner")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
}

/// Runtime agent (RAG / invoke / vault). ID is shared with CatalogAgent.agentId.
model Agent {
  id                  String   @id
  tenantId            String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agentName           String?
  role                String
  customRole          String?
  tone                String
  securityLevel       String
  publicKey           String
  systemPrompt        String   @db.Text
  invokeCount         Int      @default(0)
  googleDriveFolderId String?
  vertexDataStoreId   String?
  vertexEngineId      String?
  /// AI Applications app kind: search_docs | chat_rag | website | structured | media
  aiAppType           String?  @default("search_docs")
  /// Data source: none | google_drive | website_url | cloud_storage | api_import | vertex_studio
  dataSourceType      String?  @default("none")
  websiteUri          String?
  gcsUri              String?
  secretManagerPath   String?
  status              String   @default("ACTIVE")
  feeUsdc             Float    @default(0.001)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ownerships AgentOwnership[]
  ragDocs    RagDocument[]

  @@index([tenantId])
  @@index([vertexDataStoreId])
}

/// User ↔ Agent ownership. agentId matches CatalogAgent.agentId and Agent.id.
model AgentOwnership {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  /// owner | editor | viewer
  role      String   @default("owner")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@index([userId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  label     String
  source    String   @default("manual")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address])
  @@index([userId])
}

/// Public discovery catalog (source of truth for solvamos-catalog marketplace).
/// Replaces ephemeral /tmp JSON store. Same agentId as Agent / AgentOwnership.
model CatalogAgent {
  /// Public listing PK (solvamos_{agentId})
  catalogId       String   @id
  /// Same as Agent.id — linked to users via AgentOwnership.agentId (soft link, no FK)
  agentId         String   @unique
  fqn             String   @default("")
  title           String
  description     String   @db.Text @default("")
  useCase         String   @db.Text @default("")
  category        String   @default("ai_ml")
  role            String?
  tone            String?
  invokeUrl       String
  originInvokeUrl String?
  agentCardUrl    String?
  feeUsdc         Float    @default(0)
  token           String   @default("USDC")
  network         String   @default("devnet")
  usdcMint        String?
  paymentProtocol String   @default("free")
  recipientWallet String?
  tags            String[]
  source          String   @default("studio")
  studioOrigin    String?
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// Denormalized owner for marketplace filters (also in AgentOwnership)
  ownerUserId     String?
  owner           User?    @relation("CatalogAgentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerEmail      String?
  /// listed | unlisted | paused
  status          String   @default("listed")
  endpoints       Json?
  listedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
  @@index([ownerUserId])
  @@index([studioOrigin])
  @@index([category])
  @@map("CatalogAgent")
}

model RagDocument {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  driveFileId String
  name        String
  mimeType    String
  text        String   @db.Text
  webViewLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agentId, driveFileId])
  @@index([agentId])
}
