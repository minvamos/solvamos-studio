FROM node:22-bookworm-slim

ARG PAY_VERSION=1.0.23

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip \
  && npm install --global "@solana/pay@${PAY_VERSION}" \
  && PAY_BIN="$(npm root -g)/@solana/pay/bin/pay" \
  && if [ -x "$PAY_BIN" ]; then ln -sf "$PAY_BIN" /usr/local/bin/pay; fi \
  && pay --version \
  && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /app
COPY pay/solvamos-provider.prod.yml /app/provider.template.yml
COPY scripts/start-pay-gateway.sh /app/start-pay-gateway.sh

RUN sed -i 's/\r$//' /app/start-pay-gateway.sh \
  && chmod +x /app/start-pay-gateway.sh \
  && mkdir -p /tmp/pay-home \
  && chown -R node:node /app /tmp/pay-home

ENV PORT=8080
ENV HOME=/tmp/pay-home
EXPOSE 8080

USER node
CMD ["sh", "/app/start-pay-gateway.sh"]

